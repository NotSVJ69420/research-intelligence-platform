{
  "name": "research-intelligence-engine",
  "version": "1.0.0",
  "description": "A scholarly research intelligence platform & LaTeX authoring apparatus built with Electron, PostgreSQL, and LLM synthesis.",
  "author": "Suryavansh Jaggi",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron-main.js",
  "keywords": [
    "electron",
    "research",
    "academic-papers",
    "arxiv",
    "openalex",
    "codemirror",
    "pandoc",
    "latex",
    "groq",
    "llm"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=true electron .\"",
    "electron:build": "vite build",
    "electron:start": "electron ."
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^40.4.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.11",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "codemirror": "^6.0.2",
    "dotenv": "^17.3.1",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-katex": "^2.0.3",
    "pg": "^8.20.0",
    "xml2js": "^0.6.2"
  }
}
