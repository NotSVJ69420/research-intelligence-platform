# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=research_engine

# OpenAlex API (Optional - free tier available at https://openalex.org)
OPENALEX_API_KEY=your_openalex_api_key

# Groq API (Required for AI paper synthesis - get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# AI Service Throttling
AI_MIN_INTERVAL=2000
AI_MAX_RETRIES=3

# Environment
ELECTRON_DEV=true
